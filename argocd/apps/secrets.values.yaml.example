# Copy this file to secrets.values.yaml and fill in all values.
# The filled-in copy is gitignored — never commit it.
#
# Generate random secrets before first deploy:
#   dexClientSecret:  openssl rand -hex 32
#   cookieSecret:     python3 -c 'import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
#
# cookieSecret MUST decode to exactly 16, 24, or 32 bytes (base64url output of
# os.urandom(32) satisfies this). A plain hex string will NOT work.

global:
  secrets:
    githubClientId: ""        # GitHub OAuth App → Settings → Client ID
    githubClientSecret: ""    # GitHub OAuth App → Settings → Client Secret

    # Shared between Dex (staticClient) and oauth2-proxy.
    # Also paste this into claude.ai → MCP settings → Client Secret.
    dexClientSecret: ""

    # oauth2-proxy AES cookie key — base64url(32 random bytes)
    cookieSecret: ""

mcp-obsidian:
  mcp:
    secretEnv:
      # API key configured inside the Obsidian Local REST API community plugin.
      OBSIDIAN_API_KEY: ""
  headlessAuth:
    # Obsidian account credentials used by the obsidian-headless sync sidecar.
    obsidianEmail: ""
    obsidianPassword: ""       # Obsidian account password
    obsidianSyncPassword: ""   # Obsidian Sync end-to-end encryption password
    obsidianVault: "Default"   # vault name as shown in Obsidian Sync

mcp-calendar:
  configFile:
    content: |
      calendars:
        # iCloud — use an app-specific password
        # (appleid.apple.com → Security → App-Specific Passwords)
        - type: icloud
          name: personal
          username: user@icloud.com
          password: ""

        # Google Calendar — use an app-specific password
        # (myaccount.google.com → Security → App passwords)
        - type: google
          name: work
          username: user@gmail.com
          password: ""

        # Nextcloud — account password or app token
        # (Settings → Security → Devices & Sessions)
        - type: nextcloud
          name: shared
          url: https://cloud.example.com
          username: alice
          password: ""
          # calendar_name: ""   # optional: restrict to one calendar
          verify_ssl: true
